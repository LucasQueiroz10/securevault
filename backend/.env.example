# Modelo das variáveis de ambiente do backend.
# Para usar: copie para .env (Copy-Item .env.example .env) e ajuste os valores.
# O .env fica fora do Git (.gitignore). Este arquivo é versionado, então só
# pode conter valores fictícios.

# URL de conexão com o banco, no formato do SQLAlchemy.
DATABASE_URL=sqlite:///./securevault.db
